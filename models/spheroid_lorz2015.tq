model spheroid_lorz2015
# Lorz A, Lorenzi T, Clairambault J, Escargueil A, Perthame B. Bull Math Biol 2015;77:1-22.
# Cancer cells n over the distance from the center r and a resistance level x, both
# normalized to [0, 1]; nutrient s, a cytotoxic drug c1 and a cytostatic drug c2 diffuse in
# from the surface. Dimensionless.
axis r in [0, 1] n=40 geometry=spherical    # distance from the center
axis x in [0, 1] n=100                          # resistance level (1: the most resistant)

param mu2=10, sig_s=0.2, sig_c=0.2, g_s=1, g_c=1  # eq 2.12
param s1=0.3, C1=0, C2=0                          # the surface: nutrient, the two drugs
param eps=0.001                                   # relaxation time of s, c1, c2 (the paper: 0)

field n(r, x)
field s(r)
field c1(r)
field c2(r)

p = 0.1 + (1 - x)                                 # proliferation (eq 2.11)
d = 3 + 1.5*(1 - x)^2                             # death from competition
mu1 = 0.01 + (1 - x)^2                            # killing by the cytotoxic drug
rho = int_x(n)                                    # local density
Ds = sig_s/eps
Dc = sig_c/eps

d_t(n) = (p*s/(1 + mu2*c2) - d*rho - mu1*c1)*n
d_t(s) = d_r(Ds*d_r(s)) - (g_s + int_x(p*n))/eps*s
    at r=1: s = s1
d_t(c1) = d_r(Dc*d_r(c1)) - (g_c + int_x(mu1*n))/eps*c1
    at r=1: c1 = C1
d_t(c2) = d_r(Dc*d_r(c2)) - (g_c + mu2*rho)/eps*c2
    at r=1: c2 = C2

n(0) = 0.1*exp(-(x - 0.5)^2/0.005)                # eq 2.9 (C0 = 0.1)
s(0) = s1
c1(0) = C1
c2(0) = C2

observable total = int_r(rho)
