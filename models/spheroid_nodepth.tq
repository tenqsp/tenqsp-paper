model spheroid_nodepth
# models/spheroid_pk.tq without the depth axis: every cell sees the surface nutrient and the plasma drug.
axis x in [0, 1] n=100
param mu2=10, s1=0.3, k1=0.7, k2=0.7, isat=0
field n(x)
p = 0.1 + (1 - x)
d = 3 + 1.5*(1 - x)^2
mu1 = 0.01 + (1 - x)^2
rho = int_x(n)
kill = mu1*P1/(1 + isat*P1)
d_t(n) = (p*s1/(1 + mu2*P2) - d*rho - kill)*n
d_t(P1) = -k1*P1
d_t(P2) = -k2*P2
n(0) = 0.1*exp(-(x - 0.5)^2/0.005)
observable total = rho
observable mean_x = int_x(x*n)/rho
